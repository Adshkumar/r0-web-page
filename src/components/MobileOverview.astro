---
import { DISCUSSIONS, GITHUB, INSTALL_CMD, ISSUES, LATEST_RELEASE, RELEASES, STARS, VERSION, WINDOWS_CMD_INSTALL_CMD } from '../data/links';
import { PRODUCT_FEATURES, THEME_FAMILIES } from '../data/features';
---

<div class="mobile-overview">
  <section class="mobile-hero">
    <div class="wrap">
      <a href="/releases" class="pill mobile-release"><span class="dot"></span>r0 v{VERSION} · release notes →</a>
      <p class="mobile-kicker">// THE AI-READY CODE EDITOR</p>
      <h1>A desktop IDE for <em>modern software development.</em></h1>
      <p class="mobile-intro">
        Edit code, work with AI coding agents, manage Git, run terminal commands, and inspect supported databases—all from one desktop editor.
      </p>
      <div class="mobile-install">
        <span class="mobile-install-label">QUICK INSTALL · WINDOWS POWERSHELL</span>
        <button class="copyline" type="button" data-copy={INSTALL_CMD} aria-label="Copy Windows PowerShell install command">
          <span class="copyline-p">$</span><code><span>{INSTALL_CMD}</span></code><span class="copyline-s"></span>
        </button>
        <details class="mobile-install-more">
          <summary>Other ways to install r0</summary>
          <div class="mobile-install-methods">
            <section>
              <div class="mobile-install-method-heading"><span>WINDOWS · COMMAND PROMPT</span><span>CMD.EXE</span></div>
              <p>Run this in Command Prompt to start the Windows installer:</p>
              <button class="copyline" type="button" data-copy={WINDOWS_CMD_INSTALL_CMD} aria-label="Copy Windows Command Prompt install command">
                <span class="copyline-p">$</span><code><span>{WINDOWS_CMD_INSTALL_CMD}</span></code><span class="copyline-s"></span>
              </button>
            </section>
            <section>
              <div class="mobile-install-method-heading"><span>DIRECT DOWNLOAD</span><span>WINDOWS</span></div>
              <p>Download the installer for your processor: <code>R0_&lt;version&gt;_x64-setup.exe</code> for most PCs or <code>R0_&lt;version&gt;_arm64-setup.exe</code> for Windows on ARM.</p>
              <a href={LATEST_RELEASE} target="_blank" rel="noopener noreferrer">Choose a Windows installer →</a>
            </section>
            <section>
              <div class="mobile-install-method-heading"><span>LINUX · DEBIAN / UBUNTU</span><span>.DEB</span></div>
              <p>Download the <code>amd64</code> package for x64 or <code>arm64</code> for ARM64, then install it from the directory containing the download:</p>
              <code class="mobile-install-example">sudo apt install ./&lt;downloaded-file&gt;.deb</code>
            </section>
            <section>
              <div class="mobile-install-method-heading"><span>LINUX · FEDORA</span><span>.RPM</span></div>
              <p>Download the package matching your processor, then install it from the directory containing the download:</p>
              <code class="mobile-install-example">sudo dnf install ./&lt;downloaded-file&gt;.rpm</code>
            </section>
            <section>
              <div class="mobile-install-method-heading"><span>LINUX · APPIMAGE</span><span>PORTABLE</span></div>
              <p>When an AppImage is available, make it executable and launch it:</p>
              <code class="mobile-install-example">chmod +x &lt;file&gt;.AppImage<br />./&lt;file&gt;.AppImage</code>
            </section>
            <section>
              <div class="mobile-install-method-heading"><span>LINUX · PORTABLE ARCHIVE</span><span>X64 · ARM64</span></div>
              <p>Extract the archive for <code>linux-x86_64</code> or <code>linux-aarch64</code> and run <code>r0</code> from its extracted directory. The portable build uses system WebKitGTK 4.1 libraries.</p>
            </section>
            <a class="mobile-install-releases" href={RELEASES} target="_blank" rel="noopener noreferrer">Browse all Windows and Linux release files ↗</a>
          </div>
        </details>
        <a class="mobile-install-guide" href="/docs/getting-started/installation">Read installation instructions →</a>
      </div>
      <section class="mobile-workflow" aria-label="Ways to work in r0">
        <div class="mobile-workflow-header">
          <span><i aria-hidden="true"></i>Ways to work</span>
          <span>editor workflow</span>
        </div>
        <div class="mobile-workflow-grid">
          <div><strong><b>$</b>r0</strong><span>open your project</span></div>
          <div><strong><b>+</b>AI</strong><span>work with an agent</span></div>
          <div><strong><b>+</b>Git</strong><span>review project changes</span></div>
        </div>
      </section>
      <div class="mobile-hero-cta">
        <a class="mobile-hero-primary" href={GITHUB} target="_blank" rel="noopener noreferrer">
          <span>Explore r0 on GitHub</span>
          <span class="mobile-star-count" aria-label={`${STARS} stars`}>★ {STARS}</span>
        </a>
        <a class="mobile-hero-secondary" href="/docs">Read the documentation →</a>
      </div>
    </div>
  </section>
  <section class="mobile-features">
    <div class="wrap">
      <p class="mobile-kicker">// r0 workspace</p>
      <h2>Tools for the work <em>you do.</em></h2>
      <div class="mobile-cards">
        {PRODUCT_FEATURES.map((feature, index) => (
          <article class="mobile-card">
            <div><span>0{index + 1}</span><span>{feature.label}</span></div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
      <section class="mobile-detail-card" aria-labelledby="mobile-themes-title">
        <div class="mobile-detail-kicker"><span>F.09</span><span>APPEARANCE</span></div>
        <h3 id="mobile-themes-title">Themes that feel like yours</h3>
        <p>Start with r0 Light or r0 Dark, then explore the available theme families.</p>
        <div class="mobile-theme-options">
          <span><i class="mobile-theme-swatch swatch-dark"></i>r0 Dark</span>
          <span><i class="mobile-theme-swatch swatch-light"></i>r0 Light</span>
        </div>
        <div class="mobile-theme-families">
          {THEME_FAMILIES.map((family) => <span>{family}</span>)}
        </div>
        <a class="mobile-detail-link" href="/features#themes">Preview themes →</a>
      </section>

      <section class="mobile-detail-card mobile-git-card" aria-labelledby="mobile-git-title">
        <div class="mobile-detail-kicker"><span>GIT & GITHUB</span><span>SOURCE CONTROL</span></div>
        <h3 id="mobile-git-title">Working tree, Git &amp; GitHub review</h3>
        <p>Review your changes, stage only what belongs in the commit, then commit and push your branch.</p>
        <div class="mobile-git-steps">
          <article>
            <span class="mobile-git-step-number">01</span>
            <div>
              <div class="mobile-git-step-label"><span>REVIEW</span><span>WORKING TREE</span></div>
              <h4>Check your changes</h4>
              <p>Open Source Control in r0, review the changed files, and inspect each diff before staging.</p>
            </div>
          </article>
          <article>
            <span class="mobile-git-step-number">02</span>
            <div>
              <div class="mobile-git-step-label"><span>STAGE</span><span>SELECT FILES</span></div>
              <h4>Choose what goes in</h4>
              <p>Stage only the files for this change. Keep unrelated work out of the same commit.</p>
            </div>
          </article>
          <article>
            <span class="mobile-git-step-number">03</span>
            <div>
              <div class="mobile-git-step-label"><span>COMMIT</span><span>DESCRIBE IT</span></div>
              <h4>Save a focused commit</h4>
              <p>Enter a short message describing the change, then use the available Commit action.</p>
            </div>
          </article>
          <article>
            <span class="mobile-git-step-number">04</span>
            <div>
              <div class="mobile-git-step-label"><span>PUSH</span><span>REMOTE BRANCH</span></div>
              <h4>Publish your branch</h4>
              <p>Use Push or Sync Changes if your r0 build provides it, or push from the integrated terminal.</p>
            </div>
          </article>
        </div>
        <div class="mobile-git-terminal">
          <span>TERMINAL FALLBACK</span>
          <code>
            <span>git status</span>
            <span>git add path/to/file</span>
            <span>git diff --cached</span>
            <span>git commit -m "Describe the change"</span>
            <span>git push</span>
          </code>
        </div>
        <div class="mobile-git-legend" aria-label="Common Git file status indicators">
          <span><b class="status-modified">M</b> modified</span>
          <span><b class="status-added">A</b> added</span>
          <span><b class="status-deleted">D</b> deleted</span>
          <span><b class="status-untracked">U</b> untracked</span>
          <span><b class="status-renamed">R</b> renamed</span>
        </div>
        <div class="mobile-git-links">
          <a href="/docs/guides/git-workflow">Read the Git workflow guide →</a>
        </div>
        <div class="mobile-github-resources" aria-label="r0 GitHub links">
          <a href={GITHUB} target="_blank" rel="noopener noreferrer">
            <span>REPOSITORY</span><strong>Browse r0 source</strong><small>Code, README, and project details ↗</small>
          </a>
          <a href={LATEST_RELEASE} target="_blank" rel="noopener noreferrer">
            <span>RELEASES</span><strong>Get the latest build</strong><small>Installers and release notes ↗</small>
          </a>
          <a href={ISSUES} target="_blank" rel="noopener noreferrer">
            <span>ISSUES</span><strong>Report a problem</strong><small>File a bug or request a feature ↗</small>
          </a>
          <a href={DISCUSSIONS} target="_blank" rel="noopener noreferrer">
            <span>DISCUSSIONS</span><strong>Join the conversation</strong><small>Questions and community ideas ↗</small>
          </a>
        </div>
      </section>
    </div>
  </section>
</div>

<style>
  .mobile-hero {
    padding: 76px 0 48px;
  }

  .mobile-release {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 7px 10px;
    color: var(--txt-2);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .mobile-kicker {
    margin: 30px 0 12px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .mobile-hero h1,
  .mobile-features h2 {
    color: var(--txt);
    font-size: clamp(35px, 10vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.05em;
  }

  .mobile-hero h1 em,
  .mobile-features h2 em {
    color: var(--amber);
    font-style: normal;
  }

  .mobile-intro {
    margin: 18px 0 16px;
    color: var(--txt-2);
    font-size: 14px;
    line-height: 1.7;
  }

  .mobile-install-label {
    display: block;
    margin-bottom: 7px;
    color: var(--txt-3);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .mobile-install-more {
    display: none;
  }

  .mobile-install-more summary,
  .mobile-install-guide {
    display: flex;
    min-height: 40px;
    align-items: center;
    gap: 9px;
    padding: 0 12px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 10px;
    text-decoration: none;
  }

  .mobile-install-more summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-install-more summary::-webkit-details-marker {
    display: none;
  }

  .mobile-install-more summary::before {
    color: var(--amber);
    content: "›";
    font-size: 16px;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .mobile-install-more[open] summary::before {
    transform: rotate(90deg);
  }

  .mobile-install-more summary:focus-visible {
    outline: 1px solid var(--amber);
    outline-offset: -2px;
  }

  .mobile-install-methods {
    display: grid;
    gap: 10px;
    padding: 0 10px 10px;
  }

  .mobile-install-methods section {
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--bdr);
    background: var(--bg);
  }

  .mobile-install-method-heading {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.04em;
  }

  .mobile-install-method-heading span + span {
    color: var(--txt-3);
    text-align: right;
  }

  .mobile-install-methods p {
    margin: 8px 0;
    color: var(--txt-2);
    font-size: 10px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .mobile-install-methods p code {
    color: var(--txt);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .mobile-install-methods section > a {
    display: inline-block;
    margin-top: 2px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 9px;
    text-decoration: none;
  }

  .mobile-install-example {
    display: block;
    padding: 8px;
    border: 1px solid var(--bdr);
    background: var(--bg-elev);
    color: var(--txt);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .mobile-install-releases {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 9px;
    text-decoration: none;
  }

  .mobile-install-releases {
    padding: 10px;
    border: 1px solid var(--bdr);
    background: var(--bg);
  }

  .mobile-install-guide {
    margin-top: 2px;
    border: 1px solid var(--bdr);
    background: var(--bg-card);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .mobile-install-guide:hover {
    border-color: var(--amber);
    background: var(--bg-card);
  }

  .mobile-install-guide:focus-visible {
    outline: 1px solid var(--amber);
    outline-offset: 2px;
  }

  .mobile-workflow {
    margin-top: 8px;
    overflow: hidden;
    border: 1px solid var(--bdr);
    background: var(--bg-card);
  }

  .mobile-workflow-header {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--bdr);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mobile-workflow-header > span:first-child {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--txt-2);
    font-weight: 600;
  }

  .mobile-workflow-header i {
    display: block;
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .mobile-workflow-header > span + span {
    color: var(--txt-3);
    text-align: right;
  }

  .mobile-workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--bdr);
  }

  .mobile-workflow-grid > div {
    display: flex;
    min-width: 0;
    min-height: 64px;
    flex-direction: column;
    justify-content: center;
    padding: 8px;
    background: var(--bg-elev);
    font-family: var(--font-mono);
  }

  .mobile-workflow-grid strong {
    color: var(--txt);
    font-size: 12px;
  }

  .mobile-workflow-grid strong b {
    margin-right: 3px;
    color: var(--amber);
    font-size: 10px;
  }

  .mobile-workflow-grid > div > span {
    margin-top: 4px;
    color: var(--txt-3);
    font-size: 9px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .mobile-hero-cta {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .mobile-hero-cta a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-decoration: none;
  }

  .mobile-hero-primary {
    border: 1px solid var(--amber);
    background: var(--amber);
    color: var(--bg);
  }

  .mobile-star-count {
    flex: 0 0 auto;
    padding: 3px 6px;
    border: 1px solid currentColor;
  }

  .mobile-hero-secondary {
    border: 1px solid var(--bdr);
    color: var(--txt);
  }

  .mobile-hero-cta a:hover {
    border-color: var(--amber);
  }

  .mobile-features {
    padding: 28px 0 64px;
    border-top: 1px solid var(--bdr);
  }

  .mobile-features .mobile-kicker {
    margin-top: 0;
  }

  .mobile-features h2 {
    font-size: 30px;
  }

  .mobile-cards {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }

  .mobile-card {
    padding: 16px;
    border: 1px solid var(--bdr);
    background: var(--bg-card);
  }

  .mobile-card > div {
    display: flex;
    justify-content: space-between;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .mobile-card h3 {
    margin: 13px 0 6px;
    color: var(--txt);
    font-size: 15px;
  }

  .mobile-card p {
    margin: 0;
    color: var(--txt-2);
    font-size: 12px;
    line-height: 1.6;
  }

  .mobile-detail-card {
    margin-top: 12px;
    padding: 16px;
    border: 1px solid var(--bdr);
    background: var(--bg-card);
  }

  .mobile-detail-kicker {
    display: flex;
    justify-content: space-between;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .mobile-detail-kicker span + span { color: var(--txt-3); }

  .mobile-detail-card h3 {
    margin: 14px 0 6px;
    color: var(--txt);
    font-size: 15px;
  }

  .mobile-detail-card > p {
    margin: 0 0 13px;
    color: var(--txt-2);
    font-size: 11px;
    line-height: 1.6;
  }

  .mobile-git-card {
    margin: 22px 0 12px;
    padding: 18px;
  }

  .mobile-git-card > h3 {
    margin: 13px 0 7px;
    font-size: 20px;
    line-height: 1.2;
  }

  .mobile-git-steps {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
  }

  .mobile-git-steps article {
    display: grid;
    grid-template-columns: 25px minmax(0, 1fr);
    gap: 10px;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--bdr);
    background: var(--bg);
  }

  .mobile-git-step-number {
    padding-top: 1px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .mobile-git-steps article > div { min-width: 0; }

  .mobile-git-step-label {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .mobile-git-step-label span + span { color: var(--txt-3); text-align: right; }

  .mobile-git-steps h4 {
    margin: 9px 0 5px;
    color: var(--txt);
    font-size: 13px;
  }

  .mobile-git-steps p {
    margin: 0;
    color: var(--txt-2);
    font-size: 11px;
    line-height: 1.6;
  }

  .mobile-git-terminal {
    display: grid;
    gap: 9px;
    margin-top: 10px;
    padding: 10px 12px;
    border: 1px solid var(--bdr);
    background: var(--bg-elev);
  }

  .mobile-git-terminal > span {
    color: var(--txt-3);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.04em;
  }

  .mobile-git-terminal code {
    display: grid;
    gap: 4px;
    color: var(--txt);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
  }

  .mobile-git-terminal code span {
    overflow-wrap: anywhere;
  }

  .mobile-git-terminal code span::before {
    margin-right: 7px;
    color: var(--amber);
    content: "$";
  }

  .mobile-git-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--bdr);
    color: var(--txt-2);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .mobile-git-legend span { display: inline-flex; align-items: center; gap: 4px; }

  .mobile-git-legend b {
    display: inline-grid;
    width: 14px;
    height: 14px;
    place-items: center;
    font-size: 8px;
  }

  .status-modified { color: var(--amber); background: var(--amber-wash); }
  .status-added { color: var(--green); background: rgba(46, 160, 67, 0.14); }
  .status-deleted { color: var(--rose); background: rgba(207, 34, 46, 0.12); }
  .status-untracked { color: var(--violet); background: rgba(130, 80, 223, 0.12); }
  .status-renamed { color: var(--blue); background: rgba(9, 105, 218, 0.12); }

  .mobile-git-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
    padding-top: 11px;
    border-top: 1px solid var(--bdr);
  }

  .mobile-git-links a {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 9px;
    text-decoration: none;
  }

  .mobile-github-resources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .mobile-github-resources a {
    display: grid;
    align-content: start;
    gap: 6px;
    min-width: 0;
    padding: 11px;
    border: 1px solid var(--bdr);
    background: var(--bg);
    text-decoration: none;
  }

  .mobile-github-resources a:hover { border-color: var(--amber); }

  .mobile-github-resources span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .mobile-github-resources strong {
    color: var(--txt);
    font-size: 11px;
    font-weight: 600;
  }

  .mobile-github-resources small {
    color: var(--txt-3);
    font-size: 9px;
    line-height: 1.45;
  }

  .mobile-theme-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    margin-bottom: 10px;
  }

  .mobile-theme-options > span {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px;
    border: 1px solid var(--bdr);
    color: var(--txt-2);
    font-family: var(--font-mono);
    font-size: 9px;
  }

