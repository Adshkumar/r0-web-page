# Supabase project URL and public anon/publishable key for the r0 website.
# These are public browser values, never service-role or provider secrets.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Enable only providers already configured in Supabase Auth and their provider dashboards.
# Supported values: google,github
PUBLIC_SUPABASE_PROVIDERS=
